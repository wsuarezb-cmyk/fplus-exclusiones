@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider authStateProvider

<nav class="navbar navbar-expand-lg navbar-light shadow-lg border-bottom navbar-modern" style="height:70px;background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(248,250,252,0.98) 100%);
backdrop-filter: blur(15px);
border-bottom: 3px solid rgba(79,175,0,0.2);
box-shadow: 0 4px 20px rgba(0,0,0,0.08);">

    <div class="container-fluid px-4">
        <a class="navbar-brand text-dark fw-bold me-5 text-nowrap brand-enhanced" href="" style="font-size: 1.3rem;">
            <div class="logo-container d-flex align-items-center">
                <img src="/logo_falabella_verde.png" alt="Falabella Logo" width="50" height="50" class="me-3 bg-light rounded-3 p-2 logo-enhanced">
                <div class="brand-info">
                    <span class="brand-text d-block">PANDORA</span>
                    <span class="brand-subtitle d-block" style="font-size: 0.7rem; color: #6c757d; font-weight: 400; margin-top: -2px;">Sistema de Gestión</span>
                </div>
            </div>
        </a>
        
        <button title="Menú de navegación" class="navbar-toggler modern-toggler d-lg-none" @onclick="ToggleNavMenu" style="border: 2px solid rgba(79,175,0,0.3); border-radius: 10px;">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
            <ul class="navbar-nav me-auto nav-enhanced d-flex flex-lg-row align-items-lg-center">
                <AuthorizeView>
                    <Authorized>
                        <li class="@navItem text-nowrap nav-item-enhanced mx-1">
                            <NavLink class="nav-link text-dark fw-bold nav-link-enhanced" href="" Match="NavLinkMatch.All">
                                <span class="bi bi-house-door-fill me-2 icon-enhanced" aria-hidden="true"></span> 
                                <span class="nav-text">Inicio</span>
                            </NavLink>
                        </li>
                    </Authorized>
                </AuthorizeView>
                
                <!-- Exclusiones - Link Directo -->
                <AuthorizeView Roles="administrador,exclusiones">
                    <Authorized>
                        <li class="@navItem text-nowrap nav-item-enhanced mx-1">
                            <NavLink class="nav-link text-dark fw-bold dropdown-toggle-modern" role="button" href="exclusiones">
                                <span class="bi bi-x-circle-fill me-2 icon-enhanced" style="color: #dc3545;" aria-hidden="true"></span>
                                <span class="nav-text">Exclusiones</span>
                            </NavLink>
                        </li>
                    </Authorized>
                </AuthorizeView>
                   
            </ul>
        </div>
        <!-- User Profile Section -->
        <div class="navbar-nav ms-auto">
            <li class="dropdown-modern @navItem" style="list-style: none;">                            
                <AuthorizeView>
                    <Authorized>
                        <NavLink class="nav-link text-dark fw-bold dropdown-toggle-modern d-flex align-items-center" role="button" style="border-radius: 25px; padding: 0.5rem 1rem; background: linear-gradient(135deg, rgba(79,175,0,0.8), rgba(45,106,0,0.9)); box-shadow: 0 2px 8px rgba(79,175,0,0.2);">
                            <div class="user-info d-none d-lg-block text-nowrap">
                                <div style="font-size: 0.85rem; line-height: 1.2; color: #ffffff; font-weight: 600;">@context.User.Identity.Name</div>
                                <div style="font-size: 0.7rem; color: #ffffff; font-weight: 500;">Conectado</div>
                            </div>
                            <span class="dropdown-arrow ms-2" style="color: #ffffff;">▼</span>
                        </NavLink>
                    </Authorized>
                </AuthorizeView>
                <div class="dropdown-content-modern py-1" style="min-width: 250px; right: 0; left: auto;">
                    <div class="dropdown-header px-3 py-2 d-flex align-items-center">
                        <span class="bi bi-person-circle me-2"></span>Perfil de Usuario
                    </div>
                    <div class="px-3 py-2" style="background: linear-gradient(135deg, #4f9f00, #2d6a00); border-radius: 8px; margin: 0.5rem; box-shadow: 0 2px 8px rgba(79,175,0,0.3);">
                        <div style="font-size: 0.85rem; font-weight: 600; color: #ffffff;">@(_currentEmail ?? "usuario@falabella.com")</div>
                        <div style="font-size: 0.75rem; color: #ffffff;">Última conexión: @DateTime.Now.ToString("dd/MM HH:mm")</div>
                    </div>
                    <AuthorizeView>
                        <Authorized>
                            <NavLink class="dropdown-item-modern" @onclick="NavigateToConfiguracion" role="button">
                                <span class="bi bi-gear-fill me-3" style="color: #6c757d;"></span> 
                                <div>
                                    <div>Configuración</div>
                                    <small>Ajustes de cuenta</small>
                                </div>
                            </NavLink>
                        </Authorized>
                    </AuthorizeView>
                    
                    <div class="dropdown-divider"></div>
                    
                    <AuthorizeView>
                        <Authorized>
                            <NavLink class="dropdown-item-logout" href="logout">
                                <span class="bi bi-box-arrow-right me-3" style="color: #dc3545;"></span> 
                                <div>
                                    <div>Cerrar Sesión</div>
                                    <small>Finalizar sesión actual</small>
                                </div>
                            </NavLink>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </li>
        </div>
    </div>
</nav>

    


@code {
    private string navItem = "nav-item p-0 m-1";
    private bool collapseNavMenu = true;
    private string _currentEmail;

    string baseMenuClass = "navbar-collapse d-lg-inline-flex flex-lg-row justify-content-between w-100";
    string NavMenuCssClass => baseMenuClass + (collapseNavMenu ? " collapse" : " show");

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private void NavigateToConfiguracion()
    {
        NavigationManager.NavigateTo("/configuracion", true);
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await authStateProvider.GetAuthenticationStateAsync();
        _currentEmail = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
    }
}
