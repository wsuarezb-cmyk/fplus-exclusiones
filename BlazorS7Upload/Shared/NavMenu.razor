<aside class="forte-sidebar@(Collapsed ? " collapsed" : "")">

    <!-- Toggle contraer/expandir -->
    <button class="sidebar-toggle" @onclick="ToggleCollapsed" title="@(Collapsed ? "Expandir menú" : "Contraer menú")">
        @if (Collapsed)
        {
            <span class="bi bi-chevron-right" aria-hidden="true"></span>
        }
        else
        {
            <span class="bi bi-chevron-left" aria-hidden="true"></span>
            <span class="sidebar-label">Contraer menú</span>
        }
    </button>

    <!-- Nav items -->
    <nav class="sidebar-app-nav">

        <AuthorizeView>
            <Authorized>
                <NavLink class="sidebar-item" href="" Match="NavLinkMatch.All" title="@(Collapsed ? "Inicio" : null)">
                    <span class="bi bi-house-door-fill" style="width:20px; flex-shrink:0;" aria-hidden="true"></span>
                    <span class="sidebar-label">Inicio</span>
                </NavLink>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="operator">
            <Authorized>
                <NavLink class="sidebar-item" href="exclusiones" title="@(Collapsed ? "Exclusiones" : null)">
                    <span class="bi bi-x-circle-fill" style="width:20px; flex-shrink:0;" aria-hidden="true"></span>
                    <span class="sidebar-label">Exclusiones</span>
                </NavLink>
            </Authorized>
        </AuthorizeView>

    </nav>
</aside>

@code {
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback<bool> CollapsedChanged { get; set; }

    private async Task ToggleCollapsed()
    {
        Collapsed = !Collapsed;
        await CollapsedChanged.InvokeAsync(Collapsed);
    }
}
