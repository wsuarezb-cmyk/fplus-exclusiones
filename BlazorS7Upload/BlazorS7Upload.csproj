<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SignAssembly>False</SignAssembly>
    <DelaySign>False</DelaySign>
  </PropertyGroup>

  <!-- Excluir archivos sin uso de la compilación -->
  <ItemGroup>
    <Compile Remove="_unused\**\*.cs" />
    <Content Remove="_unused\**\*.razor" />
    <None Remove="_unused\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="ftp.json" />
  </ItemGroup>

  <ItemGroup Condition="Exists('ftp.json')">
    <None Include="ftp.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Blazor.Bootstrap" Version="2.2.0" />
	<PackageReference Include="ClosedXML" Version="0.102.2" />
	<PackageReference Include="Dapper" Version="2.1.35" />
	<PackageReference Include="Dapper.Contrib" Version="2.0.78" />
	<PackageReference Include="FluentFTP" Version="50.1.0" />
	<PackageReference Include="Google.Apis.Drive.v3" Version="1.68.0.3466" />
	<PackageReference Include="Google.Cloud.BigQuery.V2" Version="3.10.0" />
	<PackageReference Include="HtmlAgilityPack" Version="1.11.61" />
	<PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.1.0" />
	<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.0" />
	<PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.1" />
	<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.1" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.DynamicLinq" Version="9.4.9" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.1" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.1"/>
	<PackageReference Include="MySql.Data" Version="9.0.0" />
	<PackageReference Include="Npgsql" Version="9.0.3" />
	<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
	<PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
	<PackageReference Include="TaskScheduler" Version="2.11.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Authentication\Interfaces\" />
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings.json: copiado solo si existe (en Docker viene de Secret Manager) -->
    <Content Update="appsettings.json" Condition="Exists('appsettings.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Archivos de runtime montados por Secret Manager / solo locales -->
    <Content Update="appsettings.Development.json" Condition="Exists('appsettings.Development.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="mycreds.json" Condition="Exists('mycreds.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
