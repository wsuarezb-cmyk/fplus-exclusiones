@page "/exclusiones"
@attribute [Authorize(Roles = "operator")]


<PageTitle>Exclusiones</PageTitle>
<h3 class="text-center">Exclusiones @_tipo</h3>

@if (seleccionado == false)
{
    <div class="container m-auto row">
        <div class="card col mx-2 shadow text-center card_custom">
            <div class="mt-3">
                <img width="96" height="96" src="https://img.icons8.com/fluency/96/colombia-circular.png" alt="colombia-circular" />
            </div>        
            <div class="card-body">
                <h5 class="card-title">Colombia</h5>
                <div class="mt-5 mb-5">
                    <button class="btn btn-outline-primary" @onclick='() => SeleccionarExclusion("CO", "Reactivas")'>Reactivas</button>
                    <button class="btn btn-outline-success" @onclick='() => SeleccionarExclusion("CO", "Proactivas")'>Proactivas</button>
                </div>
            </div>
        </div>

        <div class="card col mx-2 shadow text-center card_custom">
            <div class="mt-3">
                <img width="96" height="96" src="https://img.icons8.com/fluency/96/chile-circular.png" alt="chile-circular" />
            </div>        
            <div class="card-body">
                <h5 class="card-title">Chile</h5>
                <div class="mt-5">
                    <button class="btn btn-outline-primary" @onclick='() => SeleccionarExclusion("CL", "Reactivas")'>Reactivas</button>
                    <button class="btn btn-outline-success" @onclick='() => SeleccionarExclusion("CL", "Proactivas")'>Proactivas</button>
                </div>
            </div>
        </div>

        <div class="card col mx-2 shadow text-center card_custom">
            <div class="mt-3">
                <img width="96" height="96" src="https://img.icons8.com/fluency/96/peru-circular.png" alt="peru-circular" />
            </div>
            <div class="card-body">
                <h5 class="card-title">Perú</h5>
                <div class="mt-5">
                    <button class="btn btn-outline-primary" @onclick='() => SeleccionarExclusion("PE", "Reactivas")'>Reactivas</button>
                    <button class="btn btn-outline-success" @onclick='() => SeleccionarExclusion("PE", "Proactivas")'>Proactivas</button>
                </div>
            </div>
        </div>
    </div>
}
@if (seleccionado)
{
    <Exclusiones paisSeleccionado="@_pais" tipoSeleccionado="@_tipo" flagUrl="@_flagUrl"></Exclusiones>
}

@code {
    bool seleccionado { get; set; } = false;
    string _pais { get; set; } = "";
    string _tipo { get; set; } = "";
    string _flagUrl { get; set; } = "";

    void SeleccionarExclusion(string pais, string tipo)
    {
        _pais = pais;        
        _tipo = tipo;

        if (pais == "CO") _flagUrl = "https://img.icons8.com/fluency/96/colombia-circular.png";
        if (pais == "CL") _flagUrl = "https://img.icons8.com/fluency/96/chile-circular.png";
        if (pais == "PE") _flagUrl = "https://img.icons8.com/fluency/96/peru-circular.png";

        seleccionado = true;
    }
}
