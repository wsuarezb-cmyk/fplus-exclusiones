@inject HelperModel _modelHelpe
@inject IExclusionesService _exclusionesService
@inject AuthenticationStateProvider authStateProvider
@inject NavigationManager _nav

@* @attribute [Authorize(Roles = "administrador, exclusiones")] *@

<AuthorizeView>
    <Authorized>
        <div class="row justify-content-around" style="margin-top: -15px">
            <div class="col ms-2 mb-1">
