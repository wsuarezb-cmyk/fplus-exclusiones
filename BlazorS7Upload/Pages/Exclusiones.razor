            </div>        
            <div class="card-body">
                <h5 class="card-title">Chile</h5>
                <div class="mt-5">
                    <button class="btn btn-outline-primary" @onclick='() => SeleccionarExclusion("CL", "Reactivas")'>Reactivas</button>
                    <button class="btn btn-outline-success" @onclick='() => SeleccionarExclusion("CL", "Proactivas")'>Proactivas</button>
